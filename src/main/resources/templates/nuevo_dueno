<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
	<head>
		<meta charset="UTF-8">
		<title>Nuevo Dueno</title>
	</head>
	<body>
		<main>
			<article>
				<h1 >DATOS NUEVO DUEÑO</h1>
				
				<form th:action="@{/dueno/guardar}" th:object="${dueno}" method="post">
					
					<label for="nombre">Nombre: </label>
					<input type="text" id="nombre" th:field="*{nombre}"/>
					
					<label for="telefono">Telefono: </label>
					<input type="number" id="telefono" th:field="*{telefono}">
					
					<label for="direccion">Direccion: </label>
					<input type="text" id="direccion" th:field="*{direccion}">
					
					<label for="usuario">Usuario: </label>
					<input type="text" id="usuario" th:field="*{usuario}">
					
					<label for="password">Password: </label>
					<input type="password" id="password" th:field="*{password}"/>
	
					<button type="submit">GUARDAR</button>
				</form>
				
			</article>
	
		</main>
	</body>
</html>
